@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+import threading
+
+from i2rt.motor_drivers.dm_driver import DMChainCanInterface
+
+
+class _FakeCanInterface:
+    def __init__(self, worker_exited: threading.Event) -> None:
+        self.worker_exited = worker_exited
+        self.closed = False
+
+    def close(self) -> None:
+        assert self.worker_exited.is_set()
+        self.closed = True
+
+
+def test_close_joins_control_thread_before_closing_can() -> None:
+    worker_started = threading.Event()
+    worker_exited = threading.Event()
+    chain = DMChainCanInterface.__new__(DMChainCanInterface)
+    chain.running = True
+    chain.start_thread_flag = True
+    chain.motor_interface = _FakeCanInterface(worker_exited)
+
+    def run_control_loop() -> None:
+        worker_started.set()
+        while chain.running:
+            pass
+        worker_exited.set()
+
+    thread = threading.Thread(target=run_control_loop)
+    chain._control_thread = thread
+    thread.start()
+    assert worker_started.wait(timeout=1.0)
+
+    chain.close()
+
+    assert not thread.is_alive()
+    assert chain._control_thread is None
+    assert chain.start_thread_flag is False
+    assert chain.motor_interface.closed is True
