+"""Drag tuning assembly tests with the CAN interface and controller replaced by mocks."""
+
+import threading
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import numpy as np
+import pytest
+
+import i2rt.robots.get_robot as factory
+from i2rt.robots.motor_chain_robot import JointCommands, MotorChainRobot
+from i2rt.robots.utils import ArmType, GripperType, _load_arm_config
+
+
+@pytest.mark.parametrize("with_gripper", [False, True])
+def test_drag_overrides_reach_controller_without_changing_defaults(
+    monkeypatch: pytest.MonkeyPatch, with_gripper: bool
+) -> None:
+    n_joints = 7 if with_gripper else 6
+    chain = MagicMock()
+    chain.read_states.return_value = [SimpleNamespace(pos=0.0) for _ in range(n_joints)]
+    chain.motor_offset = np.zeros(n_joints)
+    monkeypatch.setattr(factory, "DMChainCanInterface", MagicMock(return_value=chain))
+    controller = MagicMock()
+    monkeypatch.setattr(factory, "MotorChainRobot", controller)
+    arm = ArmType.YAM_ULTRA_2
+    gripper = GripperType.LINEAR_4310 if with_gripper else GripperType.NO_GRIPPER
+    damping = [0.1, 0.1, 0.1, 0.2, 0.05, 0.05]
+    friction = [0.1, 0.1, 0.1, 0.1, 0.02, 0.02]
+    gravity = [1.0, 1.25, 1.1, 1.1, 1.2, 1.0]
+
+    factory.get_yam_robot(
+        arm_type=arm,
+        gripper_type=gripper,
+        grav_comp_kd=damping,
+        coulomb_friction=friction,
+        gravity_comp_factor=gravity,
+        use_coulomb_friction=True,
+    )
+    args = controller.call_args.kwargs
+    np.testing.assert_array_equal(args["grav_comp_kd"], damping + ([0.0] if with_gripper else []))
+    np.testing.assert_array_equal(args["coulomb_friction"], friction + ([0.0] if with_gripper else []))
+    np.testing.assert_array_equal(args["gravity_comp_factor"], gravity + ([1.0] if with_gripper else []))
+    assert args["zero_gravity_mode"] is True
+    assert args["use_coulomb_friction"] is True
+
+    # Re-entering teach mode must retain the override and release previous position gains.
+    robot = MotorChainRobot.__new__(MotorChainRobot)
+    robot.motor_chain = [None] * n_joints
+    robot._command_lock = threading.Lock()
+    robot._grav_comp_kd = args["grav_comp_kd"]
+    robot._commands = JointCommands.init_all_zero(n_joints)
+    robot._commands.kp[:] = 80.0
+    robot._commands.pos[:] = 0.5
+    robot.enter_gravity_comp_idle()
+    np.testing.assert_array_equal(robot._commands.kp, np.zeros(n_joints))
+    np.testing.assert_array_equal(robot._commands.torques, np.zeros(n_joints))
+    np.testing.assert_array_equal(robot._commands.kd, args["grav_comp_kd"])
+
+    # A later ordinary caller still gets the original arm configuration.
+    factory.get_yam_robot(arm_type=arm, gripper_type=gripper)
+    defaults = controller.call_args.kwargs
+    hw = _load_arm_config(arm)
+    for name in ("grav_comp_kd", "coulomb_friction", "gravity_comp_factor"):
+        np.testing.assert_array_equal(defaults[name][:6], getattr(hw, name))
+    assert defaults["use_coulomb_friction"] is False
+    np.testing.assert_array_equal(hw.grav_comp_kd, [0.1, 0.1, 0.1, 0.3, 0.05, 0.05])
+    np.testing.assert_array_equal(hw.coulomb_friction, [0.3, 0.3, 0.3, 0.3, 0.06, 0.06])
+
+
+@pytest.mark.parametrize("name", ["grav_comp_kd", "coulomb_friction", "gravity_comp_factor"])
+@pytest.mark.parametrize("values", [[0.1] * 5, [0.1] * 7, [-0.1] * 6, [np.nan] * 6, [np.inf] * 6])
+def test_invalid_drag_tuning_fails_before_opening_can(
+    monkeypatch: pytest.MonkeyPatch, name: str, values: list[float]
+) -> None:
+    can_factory = MagicMock(side_effect=AssertionError("must not open CAN"))
+    monkeypatch.setattr(factory, "DMChainCanInterface", can_factory)
+    with pytest.raises(ValueError, match=name):
+        factory.get_yam_robot(arm_type=ArmType.YAM_ULTRA_2, **{name: values})
+    can_factory.assert_not_called()
+
+
+def test_gripper_assist_torque_updates_only_the_gripper_direct_torque_term() -> None:
+    robot = MotorChainRobot.__new__(MotorChainRobot)
+    robot.motor_chain = [None] * 7
+    robot._gripper_index = 6
+    robot._command_lock = threading.Lock()
+    robot._commands = JointCommands.init_all_zero(7)
+    robot._commands.torques[:6] = np.arange(6, dtype=float)
+
+    robot.set_gripper_assist_torque(0.05)
+
+    np.testing.assert_array_equal(robot._commands.torques[:6], np.arange(6, dtype=float))
+    assert robot._commands.torques[6] == pytest.approx(0.05)
+    robot.set_gripper_assist_torque(0.0)
+    assert robot._commands.torques[6] == 0.0
+
+
+def test_gripper_assist_torque_rejects_missing_gripper_or_nonfinite_value() -> None:
+    robot = MotorChainRobot.__new__(MotorChainRobot)
+    robot._gripper_index = None
+    with pytest.raises(RuntimeError, match="no motor-driven gripper"):
+        robot.set_gripper_assist_torque(0.05)
+
+    robot._gripper_index = 6
+    robot._command_lock = threading.Lock()
+    robot._commands = JointCommands.init_all_zero(7)
+    with pytest.raises(ValueError, match="finite"):
+        robot.set_gripper_assist_torque(float("nan"))
