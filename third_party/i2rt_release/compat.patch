+    def set_gripper_assist_torque(self, torque_nm: float) -> None:
+        """Set the additive direct-torque term for a motor-driven gripper.
+
+        ``torque_nm`` is expressed in this robot's joint-coordinate convention,
+        so a positive value assists positive measured gripper velocity even when
+        the installed gripper motor has reversed polarity.  It does not change
+        position targets or gains.  Callers must explicitly send ``0.0`` when
+        assistance is not wanted; this is intentionally a low-level primitive
+        rather than a latch or a position-holding mode.
+        """
+        if self._gripper_index is None:
+            raise RuntimeError("This robot has no motor-driven gripper")
+        if not np.isfinite(torque_nm):
+            raise ValueError("gripper assist torque must be finite")
+        with self._command_lock:
