@@ -0,0 +1,58 @@
+"""Hardware-free checks of cached feedback timestamps and runtime health."""
+
+import threading
+import time
+from types import SimpleNamespace
+from typing import Any
+
+import numpy as np
+import pytest
+
+from i2rt.motor_drivers.dm_driver import DMChainCanInterface
+from i2rt.robots.motor_chain_robot import MotorChainRobot
+
+
+def make_chain() -> Any:
+    chain = DMChainCanInterface.__new__(DMChainCanInterface)
+    chain.state_lock = threading.Lock()
+    chain.motor_list = [(1, "fixture")]
+    chain.state = [
+        SimpleNamespace(id=1, error_code="0x1", velocity=0.0, torque=0.0, temperature_rotor=25, temperature_mos=25)
+    ]
+    chain.motor_direction = np.ones(1)
+    chain.motor_offset = np.zeros(1)
+    chain.absolute_positions = np.zeros(1)
+    chain.running = True
+    chain.start_thread_flag = True
+    chain._control_thread = SimpleNamespace(is_alive=lambda: chain.running)
+    chain._feedback_time_unix_s = time.time() - 1
+    chain._feedback_monotonic_s = time.monotonic() - 1
+    return chain
+
+
+def test_read_states_preserves_feedback_time_when_cache_is_polled() -> None:
+    chain = make_chain()
+    first, second = chain.read_states(), chain.read_states()
+    assert first[0].timestamp == second[0].timestamp == chain._feedback_time_unix_s
+    assert chain.get_runtime_status()["state_age_s"] >= 1
+
+
+@pytest.mark.parametrize("failure", ["can", "controller", "stale_can", "stale_controller", "shutdown"])
+def test_runtime_status_detects_each_failure(failure: str) -> None:
+    chain = make_chain()
+    chain._feedback_monotonic_s = time.monotonic()
+    robot = MotorChainRobot.__new__(MotorChainRobot)
+    robot.motor_chain = chain
+    robot._server_thread = SimpleNamespace(is_alive=lambda: failure != "controller")
+    robot._stop_event = threading.Event()
+    robot._last_update_monotonic_s = time.monotonic()
+    if failure == "can":
+        chain.running = False
+    elif failure == "stale_can":
+        chain._feedback_monotonic_s -= 2
+    elif failure == "stale_controller":
+        robot._last_update_monotonic_s -= 2
+    elif failure == "shutdown":
+        robot._stop_event.set()
+    status = robot.get_runtime_status()
+    assert not status["running"] or status["state_age_s"] > 1
